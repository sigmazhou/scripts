ArrJoin( arr )
{
  s := ""
  for i,v in arr
    s .= ", " . v
  return substr(s, 3)
}

ArrMap(f, arrs*){
    minlen := PosInf
    for arr in arrs {
        minlen := Min(minlen, arr.Length)
    }
    if minlen=PosInf or minlen=0 {
        return []
    }
    r := []
    Loop minlen {
        i := A_index
        p := []
        for arr in arrs {
            p.Push(arr[i])
        }
        
        r.Push(f(p*))
    }
    return r
}

